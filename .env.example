# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# SQLite works for quick local runs (similarity computed in Python).
DATABASE_URL=sqlite:///./documind.db
# With docker-compose / Postgres + pgvector (similarity computed in the database):
# DATABASE_URL=postgresql+psycopg2://documind:documind@localhost:5432/documind
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
